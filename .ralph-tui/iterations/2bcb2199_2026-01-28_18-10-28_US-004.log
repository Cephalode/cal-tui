Result<Event, EventStoreError> {\n   103→        self.events\n   104→            .remove(id)\n   105→            .ok_or_else(|| EventStoreError::NotFound(id.to_string()))\n   106→    }\n   107→\n   108→    fn list(&self) -> Vec<&Event> {\n   109→        let mut events: Vec<&Event> = self.events.values().collect();\n   110→        events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n   111→        events\n   112→    }\n   113→\n   114→    fn query_by_date_range(&self, start: NaiveDateTime, end: NaiveDateTime) -> Result<Vec<&Event>, EventStoreError> {\n   115→        if start > end {\n   116→            return Err(EventStoreError::InvalidDateRange);\n   117→        }\n   118→\n   119→        let mut events: Vec<&Event> = self.events\n   120→            .values()\n   121→            .filter(|e| e.start_time >= start && e.start_time <= end)\n   122→            .collect();\n   123→\n   124→        events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n   125→        Ok(events)\n   126→    }\n   127→\n   128→    fn query_by_category(&self, category_name: &str) -> Vec<&Event> {\n   129→        let mut events: Vec<&Event> = self.events\n   130→            .values()\n   131→            .filter(|e| {\n   132→                e.category\n   133→                    .as_ref()\n   134→                    .map(|c| c.name == category_name)\n   135→                    .unwrap_or(false)\n   136→            })\n   137→            .collect();\n   138→\n   139→        events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n   140→        events\n   141→    }\n   142→\n   143→    fn query_by_date_range_and_category(\n   144→        &self,\n   145→        start: NaiveDateTime,\n   146→        end: NaiveDateTime,\n   147→        category_name: &str,\n   148→    ) -> Result<Vec<&Event>, EventStoreError> {\n   149→        if start > end {\n   150→            return Err(EventStoreError::InvalidDateRange);\n   151→        }\n   152→\n   153→        let mut events: Vec<&Event> = self.events\n   154→            .values()\n   155→            .filter(|e| {\n   156→                let in_range = e.start_time >= start && e.start_time <= end;\n   157→                let matches_category = e.category\n   158→                    .as_ref()\n   159→                    .map(|c| c.name == category_name)\n   160→                    .unwrap_or(false);\n   161→                in_range && matches_category\n   162→            })\n   163→            .collect();\n   164→\n   165→        events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n   166→        Ok(events)\n   167→    }\n   168→}\n   169→\n   170→#[cfg(test)]\n   171→mod tests {\n   172→    use super::*;\n   173→    use crate::events::{Category, Event, Reminder};\n   174→    use chrono::NaiveDate;\n   175→\n   176→    fn create_test_event(title: &str, day: u32, hour: u32) -> Event {\n   177→        let start = NaiveDate::from_ymd_opt(2024, 1, day)\n   178→            .unwrap()\n   179→            .and_hms_opt(hour, 0, 0)\n   180→            .unwrap();\n   181→        let end = NaiveDate::from_ymd_opt(2024, 1, day)\n   182→            .unwrap()\n   183→            .and_hms_opt(hour + 1, 0, 0)\n   184→            .unwrap();\n   185→        Event::new(title.to_string(), start, end)\n   186→    }\n   187→\n   188→    #[test]\n   189→    fn test_create_event() {\n   190→        let mut store = InMemoryEventStore::new();\n   191→        let event = create_test_event(\"Test Event\", 15, 10);\n   192→        let id = event.id.clone();\n   193→\n   194→        let result = store.create(event);\n   195→        assert!(result.is_ok());\n   196→        assert_eq!(result.unwrap(), id);\n   197→    }\n   198→\n   199→    #[test]\n   200→    fn test_create_duplicate_event() {\n   201→        let mut store = InMemoryEventStore::new();\n   202→        let event = create_test_event(\"Test Event\", 15, 10);\n   203→        let event_clone = event.clone();\n   204→\n   205→        store.create(event).unwrap();\n   206→       