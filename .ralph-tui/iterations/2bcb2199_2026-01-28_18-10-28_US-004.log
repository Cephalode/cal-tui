 259→\n   260→    #[test]\n   261→    fn test_delete_event() {\n   262→        let mut store = InMemoryEventStore::new();\n   263→        let event = create_test_event(\"Test Event\", 15, 10);\n   264→        let id = event.id.clone();\n   265→\n   266→        store.create(event).unwrap();\n   267→        let result = store.delete(&id);\n   268→\n   269→        assert!(result.is_ok());\n   270→        assert_eq!(result.unwrap().title, \"Test Event\");\n   271→        assert!(store.read(&id).is_err());\n   272→    }\n   273→\n   274→    #[test]\n   275→    fn test_delete_nonexistent_event() {\n   276→        let mut store = InMemoryEventStore::new();\n   277→        let result = store.delete(\"nonexistent\");\n   278→\n   279→        assert!(result.is_err());\n   280→        assert!(matches!(result.unwrap_err(), EventStoreError::NotFound(_)));\n   281→    }\n   282→\n   283→    #[test]\n   284→    fn test_list_events() {\n   285→        let mut store = InMemoryEventStore::new();\n   286→\n   287→        store.create(create_test_event(\"Event 3\", 17, 10)).unwrap();\n   288→        store.create(create_test_event(\"Event 1\", 15, 10)).unwrap();\n   289→        store.create(create_test_event(\"Event 2\", 16, 10)).unwrap();\n   290→\n   291→        let events = store.list();\n   292→\n   293→        assert_eq!(events.len(), 3);\n   294→        // Should be sorted by start_time\n   295→        assert_eq!(events[0].title, \"Event 1\");\n   296→        assert_eq!(events[1].title, \"Event 2\");\n   297→        assert_eq!(events[2].title, \"Event 3\");\n   298→    }\n   299→\n   300→    #[test]\n   301→    fn test_query_by_date_range() {\n   302→        let mut store = InMemoryEventStore::new();\n   303→\n   304→        store.create(create_test_event(\"Event 1\", 10, 10)).unwrap();\n   305→        store.create(create_test_event(\"Event 2\", 15, 10)).unwrap();\n   306→        store.create(create_test_event(\"Event 3\", 20, 10)).unwrap();\n   307→        store.create(create_test_event(\"Event 4\", 25, 10)).unwrap();\n   308→\n   309→        let start = NaiveDate::from_ymd_opt(2024, 1, 12)\n   310→            .unwrap()\n   311→            .and_hms_opt(0, 0, 0)\n   312→            .unwrap();\n   313→        let end = NaiveDate::from_ymd_opt(2024, 1, 22)\n   314→            .unwrap()\n   315→            .and_hms_opt(23, 59, 59)\n   316→            .unwrap();\n   317→\n   318→        let result = store.query_by_date_range(start, end);\n   319→\n   320→        assert!(result.is_ok());\n   321→        let events = result.unwrap();\n   322→        assert_eq!(events.len(), 2);\n   323→        assert_eq!(events[0].title, \"Event 2\");\n   324→        assert_eq!(events[1].title, \"Event 3\");\n   325→    }\n   326→\n   327→    #[test]\n   328→    fn test_query_by_date_range_invalid() {\n   329→        let store = InMemoryEventStore::new();\n   330→\n   331→        let start = NaiveDate::from_ymd_opt(2024, 1, 22)\n   332→            .unwrap()\n   333→            .and_hms_opt(0, 0, 0)\n   334→            .unwrap();\n   335→        let end = NaiveDate::from_ymd_opt(2024, 1, 12)\n   336→            .unwrap()\n   337→            .and_hms_opt(23, 59, 59)\n   338→            .unwrap();\n   339→\n   340→        let result = store.query_by_date_range(start, end);\n   341→\n   342→        assert!(result.is_err());\n   343→        assert!(matches!(result.unwrap_err(), EventStoreError::InvalidDateRange));\n   344→    }\n   345→\n   346→    #[test]\n   347→    fn test_query_by_category() {\n   348→        let mut store = InMemoryEventStore::new();\n   349→\n   350→        let work_category = Category::new(\"Work\".to_string());\n   351→        let personal_category = Category::new(\"Personal\".to_string());\n   352→\n   353→        let event1 = create_test_event(\"Event 1\", 15, 10)\n   354→            .with_category(work_category.clone());\n   355→        let event2 = create_test_event(\"Event 2\", 16, 10)\n   356→            .with_category(personal_category.clone());\n   357→        let event3 = create_test_event(\"Event 3\", 17, 10)\n   358→            .with_category(work_category.clone());\n   359→        let event4 = create_test_event(\"Event 4\", 18, 10); // No category\n   360→\n   361→        store.create(event1).unwrap();\n   362→        store.create(event2).unwrap();\n   363→        store.create(event3).unwrap();\n   364→        store.create(event4).unwrap();\n   365→\n   366→        let work_events = store.query_by_category(\"Work\");\n   367→        assert_eq!(work_events.len(), 2);\n   368→        assert_eq!(work_events[0].title, \"Event 1\");\n   369→        assert_eq!(work_events[1].title, \"Event 3\");\n   370→\n   371→        let personal_events = store.query_by_category(\"Personal\");\n   372→        assert_eq!(personal_events.len(), 1);\n   373→        assert_eq!(personal_events[0].title, \"Event 2\");\n   374→\n   375→        let nonexistent = store.query_by_category(\"Nonexistent\");\n   376→        assert_eq!(nonexistent.len(), 0);\n   377→    }\n   378→\n   379→    #[test]\n   380→    fn test_query_by_date_range_and_category() {\n   381→        let mut store = InMemoryEventStore::new();\n   382→\n   383→        let work_category = Category::new(\"Work\".to_string());\n   384→        let personal_category = Category::new(\"Personal\".to_string());\n   385→\n   386→        let event1 = create_test_event(\"Event 1\", 10, 10)\n   387→            .with_category(work_category.clone());\n   388→        let event2 = create_test_event(\"Event 2\", 15, 10)\n   389→            .with_category(work_category.clone());\n   390→        let event3 = create_test_event(\"Event 3\", 20, 10)\n   391→            .with_category(personal_category.clone());\n   392→        let event4 = create_test_event(\"Event 4\", 25, 10)\n   393→            .with_category(work_category.clone());\n   394→\n   395→        store.create(event1).unwrap();\n   396→        store.create(event2).unwrap();\n   397→        store.create(event3).unwrap();\n   398→        store.create(event4).unwrap();\n   399→\n   400→        let start = NaiveDate::from_ymd_opt(2024, 1, 12)\n   401→            .unwrap()\n   402→            .and_hms_opt(0, 0, 0)\n   403→            .unwrap();\n   404→        let end = NaiveDate::from_ymd_opt(2024, 1, 22)\n   405→            .unwrap()\n   406→            .and_hms_opt(23, 59, 59)\n   407→            .unwrap();\n   408→\n   409→        let result = store.query_by_date_range_and_category(start, end, \"Work\");\n   410→\n   411→        assert!(result.is_ok());\n   412→        let events = result.unwrap();\n   413→        assert_eq!(events.len(), 1);\n   414→        assert_eq!(events[0].title, \"Event 2\");\n   415→    }\n   416→\n   417→    #[test]\n   418→    fn test_query_by_date_range_and_category_invalid_range() {\n   419→        let store = InMemoryEventStore::new();\n   420→\n   421→        let start = NaiveDate::from_ymd_opt(2024, 1, 22)\n   422→            .unwrap()\n   423→            .and_hms_opt(0, 0, 0)\n   424→            .unwrap();\n   425→        let end = NaiveDate::from_ymd_opt(2024, 1, 12)\n   426→            .unwrap()\n   427→            .and_hms_opt(23, 59, 59)\n   428→            .unwrap();\n   429→\n   430→        let result = store.query_by_date_range_and_category(start, end, \"Work\");\n   431→\n   432→        assert!(result.is_err());\n   433→        assert!(matches!(result.unwrap_err(), EventStoreError::InvalidDateRange));\n   434→    }\n   435→\n   436→    #[test]\n   437→    fn test_empty_store() {\n   438→        let store = InMemoryEventStore::new();\n   439→\n   440→        assert_eq!(store.list().len(), 0);\n   441→        assert_eq!(store.query_by_category(\"Any\").len(), 0);\n   442→    }\n   443→}\n   444→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze