     \"description\": \"Implement visual mode with 'v' key for selecting multiple events or dates. Support vim-style visual selection with motion keys.\",\n      \"acceptanceCriteria\": [\n        \"'v' enters visual mode\",\n        \"Motion keys extend selection\",\n        \"Selected range highlighted\",\n        \"Actions on selection (delete, change category)\",\n        \"Escape exits visual mode\",\n        \"Visual mode indicator in status bar\",\n        \"cargo test && cargo clippy passes\"\n      ],\n      \"priority\": \"P3\",\n      \"dependencies\": [\n        \"US-025\"\n      ],\n      \"passes\": false\n    },\n    {\n      \"id\": \"US-027\",\n      \"title\": \"Add undo/redo functionality\",\n      \"description\": \"Implement undo and redo for event operations. Use 'u' for undo, 'Ctrl+r' for redo following vim conventions.\",\n      \"acceptanceCriteria\": [\n        \"Action history stack maintained\",\n        \"'u' undoes last action\",\n        \"'Ctrl+r' redoes undone action\",\n        \"Multiple undo levels\",\n        \"Redo stack cleared on new action\",\n        \"Status indicator showing undo availability\",\n        \"cargo test && cargo clippy passes\"\n      ],\n      \"priority\": \"P3\",\n      \"dependencies\": [\n        \"US-007\"\n      ],\n      \"passes\": false\n    },\n    {\n      \"id\": \"US-028\",\n      \"title\": \"Add calendar integration hints (iCal URLs)\",\n      \"description\": \"Support subscribing to remote iCal feeds. Periodically sync events from external calendars.\",\n      \"acceptanceCriteria\": [\n        \"Add remote calendar URL\",\n        \"Fetch iCal feed from URL\",\n        \"Merge external events with local events\",\n        \"Refresh interval configurable\",\n        \"Show source for imported events\",\n        \"Handle network errors gracefully\",\n        \"cargo test && cargo clippy passes\"\n      ],\n      \"priority\": \"P3\",\n      \"dependencies\": [\n        \"US-019\"\n      ],\n 