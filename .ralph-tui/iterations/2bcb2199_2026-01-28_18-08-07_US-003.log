{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018fvqQGJh8pJhAd1WXyWoxh","type":"tool_result","content":"     1→/// Events module for managing calendar events\n     2→use chrono::NaiveDateTime;\n     3→use serde::{Deserialize, Serialize};\n     4→\n     5→/// Represents the frequency of a recurring event\n     6→#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n     7→pub enum RecurrenceFrequency {\n     8→    Daily,\n     9→    Weekly,\n    10→    Monthly,\n    11→    Yearly,\n    12→}\n    13→\n    14→/// Rules for recurring events\n    15→#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n    16→pub struct RecurringRules {\n    17→    pub frequency: RecurrenceFrequency,\n    18→    pub interval: u32,\n    19→    pub count: Option<u32>,\n    20→    pub until: Option<NaiveDateTime>,\n    21→}\n    22→\n    23→impl RecurringRules {\n    24→    pub fn new(frequency: RecurrenceFrequency, interval: u32) -> Self {\n    25→        Self {\n    26→            frequency,\n    27→            interval,\n    28→            count: None,\n    29→            until: None,\n    30→        }\n    31→    }\n    32→\n    33→    pub fn with_count(mut self, count: u32) -> Self {\n    34→        self.count = Some(count);\n    35→        self\n    36→    }\n    37→\n    38→    pub fn with_until(mut self, until: NaiveDateTime) -> Self {\n    39→        self.until = Some(until);\n    40→        self\n    41→    }\n    42→}\n    43→\n    44→/// Category for organizing events\n    45→#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n    46→pub struct Category {\n    47→    pub name: String,\n    48→    pub color: Option<String>,\n    49→}\n    50→\n    51→impl Category {\n    52→    pub fn new(name: String) -> Self {\n    53→        Self { name, color: None }\n    54→    }\n    55→\n    56→    pub fn with_color(mut self, color: String) -> Self {\n    57→        self.color = Some(color);\n    58→        self\n    59→    }\n    60→}\n    61→\n    62→/// Reminder for an event\n    63→#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n    64→pub struct Reminder {\n    65→    pub minutes_before: u32,\n    66→    pub message: Option<String>,\n    67→}\n    68→\n    69→impl Reminder {\n    70→    pub fn new(minutes_before: u32) -> Self {\n    71→        Self {\n    72→            minutes_before,\n    73→            message: None,\n    74→        }\n    75→    }\n    76→\n    77→    pub fn with_message(mut self, message: String) -> Self {\n    78→        self.message = Some(message);\n    79→        self\n    80→    }\n    81→}\n    82→\n    83→/// Main event structure with all required fields\n    84→#[derive(Debug, Clone, Serialize, Deserialize)]\n    85→pub struct Event {\n    86→    pub id: String,\n    87→    pub title: String,\n    88→    pub start_time: NaiveDateTime,\n    89→    pub end_time: NaiveDateTime,\n    90→    pub description: Option<String>,\n    91→    pub location: Option<String>,\n    92→    pub recurring_rules: Option<RecurringRules>,\n    93→    pub category: Option<Category>,\n    94→    pub reminders: Vec<Reminder>,\n    95→}\n    96→\n    97→impl Event {\n    98→    pub fn new(title: String, start_time: NaiveDateTime, end_time: NaiveDateTime) -> Self {\n    99→        Self {\n   100→            id: uuid::generate(),\n   101→            title,\n   102→            start_time,\n   103→            end_time,\n   104→            description: None,\n   105→            location: None,\n   106→            recurring_rules: None,\n   107→            category: None,\n   108→            reminders: Vec::new(),\n   109→        }\n   110→    }\n   111→\n   112→    pub fn with_description(mut self, description: String) -> Self {\n   113→        self.description = Some(description);\n   114→        self\n   115→    }\n   116→\n   117→    pub fn with_location(mut self, location: String) -> Self {\n   118→        self.location = Some(location);\n   119→        self\n   120→    }\n   121→\n   122→    pub fn with_recurring_rules(mut self, rules: RecurringRules) -> Self {\n   123→        self.recurring_rules = Some(rules);\n   124→        self\n   125→    }\n   126→\n   127→    pub fn with_category(mut self, category: Category) -> Self {\n   128→        self.category = Some(category);\n   129→        self\n   130→    }\n   131→\n   132→    pub fn add_reminder(mut self, reminder: Reminder) -> Self {\n   133→        self.reminders.push(reminder);\n   134→        self\n   135→    }\n   136→\n   137→    /// Check if the event is recurring\n   138→    pub fn is_recurring(&self) -> bool {\n   139→        self.recurring_rules.is_some()\n   140→    }\n   141→\n   142→    /// Get duration in minutes\n   143→    pub fn duration_minutes(&self) -> i64 {\n   144→        (self.end_time - self.start_time).num_minutes()\n   145→    }\n   146→}\n   147→\n   148→mod uuid {\n   149→    use std::time::{SystemTime, UNIX_EPOCH};\n   150→\n   151→    pub fn generate() -> String {\n   152→        let timestamp = SystemTime::now()\n   153→            .duration_since(UNIX_EPOCH)\n   154→            .unwrap()\n   155→            .as_nanos();\n   156→        format!(\"{:x}\", timestamp)\n   157→    }\n   158→}\n   159→\n   160→#[cfg(test)]\n   161→mod tests {\n   162→    use super::*;\n   163→    use chrono::NaiveDate;\n   164→\n   165→    #[test]\n   166→    fn test_event_creation() {\n   167→        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n   168→            .unwrap()\n   169→            .and_hms_opt(10, 0, 0)\n   170→            .unwrap();\n   171→        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n   172→            .unwrap()\n   173→            .and_hms_opt(11, 0, 0)\n   174→            .unwrap();\n   175→\n   176→        let event = Event::new(\"Test Event\".to_string(), start, end);\n   177→\n   178→        assert_eq!(event.title, \"Test Event\");\n   179→        assert_eq!(event.start_time, start);\n   180→        assert_eq!(event.end_time, end);\n   181→        assert!(event.description.is_none());\n   182→        assert!(event.location.is_none());\n   183→        assert!(event.recurring_rules.is_none());\n   184→        assert!(event.category.is_none());\n   185→        assert!(event.reminders.is_empty());\n   186→        assert!(!event.id.is_empty());\n   187→    }\n   188→\n   189→    #[test]\n   190→    fn test_event_with_builder_methods() {\n   191→        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n   192→            .unwrap()\n   193→            .and_hms_opt(10, 0, 0)\n   194→            .unwrap();\n   195→        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n   196→            .unwrap()\n   197→            .and_hms_opt(11, 0, 0)\n   198→            .unwrap();\n   199→\n   200→        let category = Category::new(\"Work\".to_string()).with_color(\"blue\".to_string());\n   201→        let reminder = Reminder::new(15).with_message(\"Meeting in 15 minutes\".to_string());\n   202→\n   203→        let event = Event::new(\"Team Meeting\".to_string(), start, end)\n   204→            .with_description(\"Weekly team sync\".to_string())\n   205→            .with_location(\"Conference Room A\".to_string())\n   206→            .with_category(category.clone())\n   207→            .add_reminder(reminder.clone());\n   208→\n   209→        assert_eq!(event.description, Some(\"Weekly team sync\".to_string()));\n   210→        assert_eq!(event.location, Some(\"Conference Room A\".to_string()));\n   211→        assert_eq!(event.category.as_ref().unwrap().name, \"Work\");\n   212→        assert_eq!(event.reminders.len(), 1);\n   213→        assert_eq!(event.reminders[0].minutes_before, 15);\n   214→    }\n   215→\n   216→    #[test]\n   217→    fn test_recurring_event() {\n   218→        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n   219→            .unwrap()\n   220→            .and_hms_opt(10, 0, 0)\n   221→            .unwrap();\n   222→        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n   223→            .unwrap()\n   224→            .and_hms_opt(11, 0, 0)\n   225→            .unwrap();\n   226→\n   227→        let rules = RecurringRules::new(RecurrenceFrequency::Weekly, 1).with_count(10);\n   228→\n   229→        let event = Event::new(\"Weekly Standup\".to_string(), start, end)\n   230→            .with_recurring_rules(rules);\n   231→\n   232→        assert!(event.is_recurring());\n   233→        assert_eq!(\n   234→            event.recurring_rules.as_ref().unwrap().frequency,\n   235→            RecurrenceFrequency::Weekly\n   236→        );\n   237→        assert_eq!(event.recurring_rules.as_ref().unwrap().count, Some(10));\n   238→    }\n   239→\n   240→    #[test]\n   241→    fn test_event_duration() {\n   242→        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n   243→            .unwrap()\n   244→            .and_hms_opt(10, 0, 0)\n   245→            .unwrap();\n   246→        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n   247→            .unwrap()\n   248→            .and_hms_opt(11, 30, 0)\n   249→            .unwrap();\n   250→\n   251→        let event = Event::new(\"Test\".to_string(), start, end);\n   252→        assert_eq!(event.duration_minutes(), 90);\n   253→    }\n   254→\n   255→    #[test]\n   256→    fn test_event_serialization() {\n   257→        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n   258→            .unwrap()\n   259→            .and_hms_opt(10, 0, 0)\n   260→            .unwrap();\n   261→        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n   262→            .unwrap()\n   263→            .and_hms_opt(11, 0, 0)\n   264→            .unwrap();\n   265→\n   266→        let event = Event::new(\"Test Event\".to_string(), start, end)\n   267→            .with_description(\"Test description\".to_string());\n   268→\n   269→        let json = serde_json::to_string(&event).unwrap();\n   270→        let deserialized: Event = serde_json::from_str(&json).unwrap();\n   271→\n   272→        assert_eq!(event.title, deserialized.title);\n   273→        assert_eq!(event.description, deserialized.description);\n   274→        assert_eq!(event.start_time, deserialized.start_time);\n   275→        assert_eq!(event.end_time, deserialized.end_time);\n   276→    }\n   277→\n   278→    #[test]\n   279→    fn test_category_creation() {\n   280→        let category = Category::new(\"Personal\".to_string()).with_color(\"red\".to_string());\n   281→\n   282→        assert_eq!(category.name, \"Personal\");\n   283→        assert_eq!(category.color, Some(\"red\".to_string()));\n   284→    }\n   285→\n   286→    #[test]\n   287→    fn test_reminder_creation() {\n   288→        let reminder = Reminder::new(30).with_message(\"Custom reminder\".to_string());\n   289→\n   290→        assert_eq!(reminder.minutes_before, 30);\n   291→        assert_eq!(reminder.message, Some(\"Custom reminder\".to_string()));\n   292→    }\n   293→\n   294→    #[test]\n   295→    fn test_recurring_rules_with_until() {\n   296→        let until = NaiveDate::from_ymd_opt(2024, 12, 31)\n   297→            .unwrap()\n   298→            .and_hms_opt(23, 59, 59)\n   299→            .unwrap();\n   300→\n   301→        let rules = RecurringRules::new(RecurrenceFrequency::Daily, 1).with_until(until);\n   302→\n   303→        assert_eq!(rules.frequency, RecurrenceFrequency::Daily);\n   304→        assert_eq!(rules.interval, 1);\n   305→        assert_eq!(rules.until, Some(until));\n   306→        assert_eq!(rules.count, None);\n   307→    }\n   308→}\n   309→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b01c02b5-c3bf-4330-afae-c2052155ab63","uuid":"b8ab6f48-7c44-480e-aed2-a9273a7ec6d8","tool_use_result":{"type":"text","file":{"filePath":"/Users/sqibo/devel/clawd/src/events/mod.rs","content":"/// Events module for managing calendar events\nuse chrono::NaiveDateTime;\nuse serde::{Deserialize, Serialize};\n\n/// Represents the frequency of a recurring event\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub enum RecurrenceFrequency {\n    Daily,\n    Weekly,\n    Monthly,\n    Yearly,\n}\n\n/// Rules for recurring events\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct RecurringRules {\n    pub frequency: RecurrenceFrequency,\n    pub interval: u32,\n    pub count: Option<u32>,\n    pub until: Option<NaiveDateTime>,\n}\n\nimpl RecurringRules {\n    pub fn new(frequency: RecurrenceFrequency, interval: u32) -> Self {\n        Self {\n            frequency,\n            interval,\n            count: None,\n            until: None,\n        }\n    }\n\n    pub fn with_count(mut self, count: u32) -> Self {\n        self.count = Some(count);\n        self\n    }\n\n    pub fn with_until(mut self, until: NaiveDateTime) -> Self {\n        self.until = Some(until);\n        self\n    }\n}\n\n/// Category for organizing events\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct Category {\n    pub name: String,\n    pub color: Option<String>,\n}\n\nimpl Category {\n    pub fn new(name: String) -> Self {\n        Self { name, color: None }\n    }\n\n    pub fn with_color(mut self, color: String) -> Self {\n        self.color = Some(color);\n        self\n    }\n}\n\n/// Reminder for an event\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\npub struct Reminder {\n    pub minutes_before: u32,\n    pub message: Option<String>,\n}\n\nimpl Reminder {\n    pub fn new(minutes_before: u32) -> Self {\n        Self {\n            minutes_before,\n            message: None,\n        }\n    }\n\n    pub fn with_message(mut self, message: String) -> Self {\n        self.message = Some(message);\n        self\n    }\n}\n\n/// Main event structure with all required fields\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct Event {\n    pub id: String,\n    pub title: String,\n    pub start_time: NaiveDateTime,\n    pub end_time: NaiveDateTime,\n    pub description: Option<String>,\n    pub location: Option<String>,\n    pub recurring_rules: Option<RecurringRules>,\n    pub category: Option<Category>,\n    pub reminders: Vec<Reminder>,\n}\n\nimpl Event {\n    pub fn new(title: String, start_time: NaiveDateTime, end_time: NaiveDateTime) -> Self {\n        Self {\n            id: uuid::generate(),\n            title,\n            start_time,\n            end_time,\n            description: None,\n            location: None,\n            recurring_rules: None,\n            category: None,\n            reminders: Vec::new(),\n        }\n    }\n\n    pub fn with_description(mut self, description: String) -> Self {\n        self.description = Some(description);\n        self\n    }\n\n    pub fn with_location(mut self, location: String) -> Self {\n        self.location = Some(location);\n        self\n    }\n\n    pub fn with_recurring_rules(mut self, rules: RecurringRules) -> Self {\n        self.recurring_rules = Some(rules);\n        self\n    }\n\n    pub fn with_category(mut self, category: Category) -> Self {\n        self.category = Some(category);\n        self\n    }\n\n    pub fn add_reminder(mut self, reminder: Reminder) -> Self {\n        self.reminders.push(reminder);\n        self\n    }\n\n    /// Check if the event is recurring\n    pub fn is_recurring(&self) -> bool {\n        self.recurring_rules.is_some()\n    }\n\n    /// Get duration in minutes\n    pub fn duration_minutes(&self) -> i64 {\n        (self.end_time - self.start_time).num_minutes()\n    }\n}\n\nmod uuid {\n    use std::time::{SystemTime, UNIX_EPOCH};\n\n    pub fn generate() -> String {\n        let timestamp = SystemTime::now()\n            .duration_since(UNIX_EPOCH)\n            .unwrap()\n            .as_nanos();\n        format!(\"{:x}\", timestamp)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use chrono::NaiveDate;\n\n    #[test]\n    fn test_event_creation() {\n        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(10, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(11, 0, 0)\n            .unwrap();\n\n        let event = Event::new(\"Test Event\".to_string(), start, end);\n\n        assert_eq!(event.title, \"Test Event\");\n        assert_eq!(event.start_time, start);\n        assert_eq!(event.end_time, end);\n        assert!(event.description.is_none());\n        assert!(event.location.is_none());\n        assert!(event.recurring_rules.is_none());\n        assert!(event.category.is_none());\n        assert!(event.reminders.is_empty());\n        assert!(!event.id.is_empty());\n    }\n\n    #[test]\n    fn test_event_with_builder_methods() {\n        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(10, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(11, 0, 0)\n            .unwrap();\n\n        let category = Category::new(\"Work\".to_string()).with_color(\"blue\".to_string());\n        let reminder = Reminder::new(15).with_message(\"Meeting in 15 minutes\".to_string());\n\n        let event = Event::new(\"Team Meeting\".to_string(), start, end)\n            .with_description(\"Weekly team sync\".to_string())\n            .with_location(\"Conference Room A\".to_string())\n            .with_category(category.clone())\n            .add_reminder(reminder.clone());\n\n        assert_eq!(event.description, Some(\"Weekly team sync\".to_string()));\n        assert_eq!(event.location, Some(\"Conference Room A\".to_string()));\n        assert_eq!(event.category.as_ref().unwrap().name, \"Work\");\n        assert_eq!(event.reminders.len(), 1);\n        assert_eq!(event.reminders[0].minutes_before, 15);\n    }\n\n    #[test]\n    fn test_recurring_event() {\n        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(10, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(11, 0, 0)\n            .unwrap();\n\n        let rules = RecurringRules::new(RecurrenceFrequency::Weekly, 1).with_count(10);\n\n        let event = Event::new(\"Weekly Standup\".to_string(), start, end)\n            .with_recurring_rules(rules);\n\n        assert!(event.is_recurring());\n        assert_eq!(\n            event.recurring_rules.as_ref().unwrap().frequency,\n            RecurrenceFrequency::Weekly\n        );\n        assert_eq!(event.recurring_rules.as_ref().unwrap().count, Some(10));\n    }\n\n    #[test]\n    fn test_event_duration() {\n        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(10, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(11, 30, 0)\n            .unwrap();\n\n        let event = Event::new(\"Test\".to_string(), start, end);\n        assert_eq!(event.duration_minutes(), 90);\n    }\n\n    #[test]\n    fn test_event_serialization() {\n        let start = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(10, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 15)\n            .unwrap()\n            .and_hms_opt(11, 0, 0)\n            .unwrap();\n\n        let event = Event::new(\"Test Event\".to_string(), start, end)\n            .with_description(\"Test description\".to_string());\n\n        let json = serde_json::to_string(&event).unwrap();\n        let deserialized: Event = serde_json::from_str(&json).unwrap();\n\n        assert_eq!(event.title, deserialized.title);\n        assert_eq!(event.description, deserialized.description);\n        assert_eq!(event.start_time, deserialized.start_time);\n        assert_eq!(event.end_time, deserialized.end_time);\n    }\n\n    #[test]\n    fn test_category_creation() {\n        let category = Category::new(\"Personal\".to_string()).with_color(\"red\".to_string());\n\n        assert_eq!(category.name, \"Personal\");\n        assert_eq!(category.color, Some(\"red\".to_string()));\n    }\n\n    #[test]\n    fn test_reminder_creation() {\n        let reminder = Reminder::new(30).with_message(\"Custom reminder\".to_string());\n\n        assert_eq!(reminder.minutes_before, 30);\n        assert_eq!(reminder.message, Some(\"Custom reminder\".to_string()));\n    }\n\n    #[test]\n    fn test_recurring_rules_with_until() {\n        let until = NaiveDate::from_ymd_opt(2024, 12, 31)\n            .unwrap()\n            .and_hms_opt(23, 59, 59)\n            .unwrap();\n\n        let rules = RecurringRules::new(RecurrenceFrequency::Daily, 1).with_until(until);\n\n        assert_eq!(rules.frequency, RecurrenceFrequency::Daily);\n        assert_eq!(rules.interval, 1);\n        assert_eq!(rules.until, Some(until));\n        assert_eq!(rules.count, None);\n    }\n}\n","numLines":309,"startLine":1,"totalLines":309}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N9j4csMp4GYRfyaVLzVqkD","type":"tool_result","content":"     1→use chrono::{NaiveDate, Datelike, Duration};\n     2→use serde::{Deserialize, Serialize};\n     3→use crate::events::Event;\n     4→\n     5→/// Represents different view modes for the calendar\n     6→#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n     7→pub enum ViewMode {\n     8→    Day,\n     9→    Week,\n    10→    Month,\n    11→    Year,\n    12→}\n    13→\n    14→impl Default for ViewMode {\n    15→    fn default() -> Self {\n    16→        ViewMode::Month\n    17→    }\n    18→}\n    19→\n    20→/// Represents a calendar view\n    21→#[derive(Debug, Clone)]\n    22→pub struct Calendar {\n    23→    pub current_date: NaiveDate,\n    24→}\n    25→\n    26→impl Calendar {\n    27→    pub fn new() -> Self {\n    28→        Self {\n    29→            current_date: chrono::Local::now().date_naive(),\n    30→        }\n    31→    }\n    32→\n    33→    pub fn month(&self) -> u32 {\n    34→        self.current_date.month()\n    35→    }\n    36→\n    37→    pub fn year(&self) -> i32 {\n    38→        self.current_date.year()\n    39→    }\n    40→}\n    41→\n    42→impl Default for Calendar {\n    43→    fn default() -> Self {\n    44→        Self::new()\n    45→    }\n    46→}\n    47→\n    48→/// Main state management for the calendar application\n    49→#[derive(Debug, Clone, Serialize, Deserialize)]\n    50→pub struct CalendarState {\n    51→    pub current_date: NaiveDate,\n    52→    pub view_mode: ViewMode,\n    53→    pub events: Vec<Event>,\n    54→    pub selected_event_index: Option<usize>,\n    55→}\n    56→\n    57→impl CalendarState {\n    58→    pub fn new() -> Self {\n    59→        Self {\n    60→            current_date: chrono::Local::now().date_naive(),\n    61→            view_mode: ViewMode::default(),\n    62→            events: Vec::new(),\n    63→            selected_event_index: None,\n    64→        }\n    65→    }\n    66→\n    67→    /// Add an event to the calendar\n    68→    pub fn add_event(&mut self, event: Event) {\n    69→        self.events.push(event);\n    70→        self.sort_events();\n    71→    }\n    72→\n    73→    /// Remove an event by ID\n    74→    pub fn remove_event(&mut self, event_id: &str) -> Option<Event> {\n    75→        if let Some(pos) = self.events.iter().position(|e| e.id == event_id) {\n    76→            Some(self.events.remove(pos))\n    77→        } else {\n    78→            None\n    79→        }\n    80→    }\n    81→\n    82→    /// Get an event by ID\n    83→    pub fn get_event(&self, event_id: &str) -> Option<&Event> {\n    84→        self.events.iter().find(|e| e.id == event_id)\n    85→    }\n    86→\n    87→    /// Get a mutable reference to an event by ID\n    88→    pub fn get_event_mut(&mut self, event_id: &str) -> Option<&mut Event> {\n    89→        self.events.iter_mut().find(|e| e.id == event_id)\n    90→    }\n    91→\n    92→    /// Get all events for a specific date\n    93→    pub fn events_on_date(&self, date: NaiveDate) -> Vec<&Event> {\n    94→        self.events\n    95→            .iter()\n    96→            .filter(|e| e.start_time.date() == date)\n    97→            .collect()\n    98→    }\n    99→\n   100→    /// Get all events in a date range\n   101→    pub fn events_in_range(&self, start: NaiveDate, end: NaiveDate) -> Vec<&Event> {\n   102→        self.events\n   103→            .iter()\n   104→            .filter(|e| {\n   105→                let event_date = e.start_time.date();\n   106→                event_date >= start && event_date <= end\n   107→            })\n   108→            .collect()\n   109→    }\n   110→\n   111→    /// Change the view mode\n   112→    pub fn set_view_mode(&mut self, mode: ViewMode) {\n   113→        self.view_mode = mode;\n   114→    }\n   115→\n   116→    /// Navigate to next period based on current view mode\n   117→    pub fn next_period(&mut self) {\n   118→        self.current_date = match self.view_mode {\n   119→            ViewMode::Day => self.current_date + Duration::days(1),\n   120→            ViewMode::Week => self.current_date + Duration::weeks(1),\n   121→            ViewMode::Month => {\n   122→                let month = self.current_date.month();\n   123→                let year = self.current_date.year();\n   124→                if month == 12 {\n   125→                    NaiveDate::from_ymd_opt(year + 1, 1, 1).unwrap()\n   126→                } else {\n   127→                    NaiveDate::from_ymd_opt(year, month + 1, 1).unwrap()\n   128→                }\n   129→            }\n   130→            ViewMode::Year => {\n   131→                NaiveDate::from_ymd_opt(self.current_date.year() + 1, 1, 1).unwrap()\n   132→            }\n   133→        };\n   134→    }\n   135→\n   136→    /// Navigate to previous period based on current view mode\n   137→    pub fn previous_period(&mut self) {\n   138→        self.current_date = match self.view_mode {\n   139→            ViewMode::Day => self.current_date - Duration::days(1),\n   140→            ViewMode::Week => self.current_date - Duration::weeks(1),\n   141→            ViewMode::Month => {\n   142→                let month = self.current_date.month();\n   143→                let year = self.current_date.year();\n   144→                if month == 1 {\n   145→                    NaiveDate::from_ymd_opt(year - 1, 12, 1).unwrap()\n   146→                } else {\n   147→                    NaiveDate::from_ymd_opt(year, month - 1, 1).unwrap()\n   148→                }\n   149→            }\n   150→            ViewMode::Year => {\n   151→                NaiveDate::from_ymd_opt(self.current_date.year() - 1, 1, 1).unwrap()\n   152→            }\n   153→        };\n   154→    }\n   155→\n   156→    /// Go to today's date\n   157→    pub fn go_to_today(&mut self) {\n   158→        self.current_date = chrono::Local::now().date_naive();\n   159→    }\n   160→\n   161→    /// Select next event\n   162→    pub fn select_next_event(&mut self) {\n   163→        if self.events.is_empty() {\n   164→            self.selected_event_index = None;\n   165→            return;\n   166→        }\n   167→\n   168→        self.selected_event_index = Some(match self.selected_event_index {\n   169→            Some(index) => {\n   170→                if index >= self.events.len() - 1 {\n   171→                    0\n   172→                } else {\n   173→                    index + 1\n   174→                }\n   175→            }\n   176→            None => 0,\n   177→        });\n   178→    }\n   179→\n   180→    /// Select previous event\n   181→    pub fn select_previous_event(&mut self) {\n   182→        if self.events.is_empty() {\n   183→            self.selected_event_index = None;\n   184→            return;\n   185→        }\n   186→\n   187→        self.selected_event_index = Some(match self.selected_event_index {\n   188→            Some(index) => {\n   189→                if index == 0 {\n   190→                    self.events.len() - 1\n   191→                } else {\n   192→                    index - 1\n   193→                }\n   194→            }\n   195→            None => self.events.len() - 1,\n   196→        });\n   197→    }\n   198→\n   199→    /// Get currently selected event\n   200→    pub fn selected_event(&self) -> Option<&Event> {\n   201→        self.selected_event_index\n   202→            .and_then(|index| self.events.get(index))\n   203→    }\n   204→\n   205→    /// Sort events by start time\n   206→    fn sort_events(&mut self) {\n   207→        self.events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n   208→    }\n   209→\n   210→    /// Get total number of events\n   211→    pub fn event_count(&self) -> usize {\n   212→        self.events.len()\n   213→    }\n   214→}\n   215→\n   216→impl Default for CalendarState {\n   217→    fn default() -> Self {\n   218→        Self::new()\n   219→    }\n   220→}\n   221→\n   222→#[cfg(test)]\n   223→mod tests {\n   224→    use super::*;\n   225→    use crate::events::{Event, Category, Reminder, RecurringRules, RecurrenceFrequency};\n   226→\n   227→    fn create_test_event(title: &str, day: u32, hour: u32) -> Event {\n   228→        let start = NaiveDate::from_ymd_opt(2024, 1, day)\n   229→            .unwrap()\n   230→            .and_hms_opt(hour, 0, 0)\n   231→            .unwrap();\n   232→        let end = NaiveDate::from_ymd_opt(2024, 1, day)\n   233→            .unwrap()\n   234→            .and_hms_opt(hour + 1, 0, 0)\n   235→            .unwrap();\n   236→        Event::new(title.to_string(), start, end)\n   237→    }\n   238→\n   239→    #[test]\n   240→    fn test_calendar_state_creation() {\n   241→        let state = CalendarState::new();\n   242→\n   243→        assert_eq!(state.view_mode, ViewMode::Month);\n   244→        assert_eq!(state.events.len(), 0);\n   245→        assert_eq!(state.selected_event_index, None);\n   246→    }\n   247→\n   248→    #[test]\n   249→    fn test_add_event() {\n   250→        let mut state = CalendarState::new();\n   251→        let event = create_test_event(\"Test Event\", 15, 10);\n   252→\n   253→        state.add_event(event.clone());\n   254→\n   255→        assert_eq!(state.events.len(), 1);\n   256→        assert_eq!(state.events[0].title, \"Test Event\");\n   257→    }\n   258→\n   259→    #[test]\n   260→    fn test_remove_event() {\n   261→        let mut state = CalendarState::new();\n   262→        let event = create_test_event(\"Test Event\", 15, 10);\n   263→        let event_id = event.id.clone();\n   264→\n   265→        state.add_event(event);\n   266→        assert_eq!(state.events.len(), 1);\n   267→\n   268→        let removed = state.remove_event(&event_id);\n   269→        assert!(removed.is_some());\n   270→        assert_eq!(state.events.len(), 0);\n   271→    }\n   272→\n   273→    #[test]\n   274→    fn test_get_event() {\n   275→        let mut state = CalendarState::new();\n   276→        let event = create_test_event(\"Test Event\", 15, 10);\n   277→        let event_id = event.id.clone();\n   278→\n   279→        state.add_event(event);\n   280→\n   281→        let found = state.get_event(&event_id);\n   282→        assert!(found.is_some());\n   283→        assert_eq!(found.unwrap().title, \"Test Event\");\n   284→    }\n   285→\n   286→    #[test]\n   287→    fn test_events_on_date() {\n   288→        let mut state = CalendarState::new();\n   289→\n   290→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   291→        state.add_event(create_test_event(\"Event 2\", 15, 14));\n   292→        state.add_event(create_test_event(\"Event 3\", 16, 10));\n   293→\n   294→        let date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   295→        let events = state.events_on_date(date);\n   296→\n   297→        assert_eq!(events.len(), 2);\n   298→    }\n   299→\n   300→    #[test]\n   301→    fn test_events_in_range() {\n   302→        let mut state = CalendarState::new();\n   303→\n   304→        state.add_event(create_test_event(\"Event 1\", 10, 10));\n   305→        state.add_event(create_test_event(\"Event 2\", 15, 10));\n   306→        state.add_event(create_test_event(\"Event 3\", 20, 10));\n   307→        state.add_event(create_test_event(\"Event 4\", 25, 10));\n   308→\n   309→        let start = NaiveDate::from_ymd_opt(2024, 1, 12).unwrap();\n   310→        let end = NaiveDate::from_ymd_opt(2024, 1, 22).unwrap();\n   311→        let events = state.events_in_range(start, end);\n   312→\n   313→        assert_eq!(events.len(), 2);\n   314→    }\n   315→\n   316→    #[test]\n   317→    fn test_view_mode_changes() {\n   318→        let mut state = CalendarState::new();\n   319→\n   320→        assert_eq!(state.view_mode, ViewMode::Month);\n   321→\n   322→        state.set_view_mode(ViewMode::Week);\n   323→        assert_eq!(state.view_mode, ViewMode::Week);\n   324→\n   325→        state.set_view_mode(ViewMode::Day);\n   326→        assert_eq!(state.view_mode, ViewMode::Day);\n   327→    }\n   328→\n   329→    #[test]\n   330→    fn test_next_period_day() {\n   331→        let mut state = CalendarState::new();\n   332→        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   333→        state.set_view_mode(ViewMode::Day);\n   334→\n   335→        state.next_period();\n   336→        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 1, 16).unwrap());\n   337→    }\n   338→\n   339→    #[test]\n   340→    fn test_next_period_month() {\n   341→        let mut state = CalendarState::new();\n   342→        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   343→        state.set_view_mode(ViewMode::Month);\n   344→\n   345→        state.next_period();\n   346→        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 2, 1).unwrap());\n   347→    }\n   348→\n   349→    #[test]\n   350→    fn test_next_period_year() {\n   351→        let mut state = CalendarState::new();\n   352→        state.current_date = NaiveDate::from_ymd_opt(2024, 6, 15).unwrap();\n   353→        state.set_view_mode(ViewMode::Year);\n   354→\n   355→        state.next_period();\n   356→        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2025, 1, 1).unwrap());\n   357→    }\n   358→\n   359→    #[test]\n   360→    fn test_previous_period_day() {\n   361→        let mut state = CalendarState::new();\n   362→        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   363→        state.set_view_mode(ViewMode::Day);\n   364→\n   365→        state.previous_period();\n   366→        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 1, 14).unwrap());\n   367→    }\n   368→\n   369→    #[test]\n   370→    fn test_previous_period_month() {\n   371→        let mut state = CalendarState::new();\n   372→        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   373→        state.set_view_mode(ViewMode::Month);\n   374→\n   375→        state.previous_period();\n   376→        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2023, 12, 1).unwrap());\n   377→    }\n   378→\n   379→    #[test]\n   380→    fn test_event_selection() {\n   381→        let mut state = CalendarState::new();\n   382→\n   383→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   384→        state.add_event(create_test_event(\"Event 2\", 16, 10));\n   385→        state.add_event(create_test_event(\"Event 3\", 17, 10));\n   386→\n   387→        assert_eq!(state.selected_event_index, None);\n   388→\n   389→        state.select_next_event();\n   390→        assert_eq!(state.selected_event_index, Some(0));\n   391→\n   392→        state.select_next_event();\n   393→        assert_eq!(state.selected_event_index, Some(1));\n   394→\n   395→        state.select_previous_event();\n   396→        assert_eq!(state.selected_event_index, Some(0));\n   397→    }\n   398→\n   399→    #[test]\n   400→    fn test_event_selection_wrapping() {\n   401→        let mut state = CalendarState::new();\n   402→\n   403→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   404→        state.add_event(create_test_event(\"Event 2\", 16, 10));\n   405→\n   406→        state.select_next_event();\n   407→        state.select_next_event();\n   408→        assert_eq!(state.selected_event_index, Some(1));\n   409→\n   410→        // Should wrap to beginning\n   411→        state.select_next_event();\n   412→        assert_eq!(state.selected_event_index, Some(0));\n   413→\n   414→        // Should wrap to end\n   415→        state.select_previous_event();\n   416→        assert_eq!(state.selected_event_index, Some(1));\n   417→    }\n   418→\n   419→    #[test]\n   420→    fn test_selected_event() {\n   421→        let mut state = CalendarState::new();\n   422→\n   423→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   424→        state.add_event(create_test_event(\"Event 2\", 16, 10));\n   425→\n   426→        assert!(state.selected_event().is_none());\n   427→\n   428→        state.select_next_event();\n   429→        let selected = state.selected_event();\n   430→        assert!(selected.is_some());\n   431→        assert_eq!(selected.unwrap().title, \"Event 1\");\n   432→    }\n   433→\n   434→    #[test]\n   435→    fn test_event_sorting() {\n   436→        let mut state = CalendarState::new();\n   437→\n   438→        state.add_event(create_test_event(\"Event 3\", 17, 10));\n   439→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   440→        state.add_event(create_test_event(\"Event 2\", 16, 10));\n   441→\n   442→        // Events should be sorted by start time\n   443→        assert_eq!(state.events[0].title, \"Event 1\");\n   444→        assert_eq!(state.events[1].title, \"Event 2\");\n   445→        assert_eq!(state.events[2].title, \"Event 3\");\n   446→    }\n   447→\n   448→    #[test]\n   449→    fn test_event_count() {\n   450→        let mut state = CalendarState::new();\n   451→\n   452→        assert_eq!(state.event_count(), 0);\n   453→\n   454→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   455→        assert_eq!(state.event_count(), 1);\n   456→\n   457→        state.add_event(create_test_event(\"Event 2\", 16, 10));\n   458→        assert_eq!(state.event_count(), 2);\n   459→    }\n   460→\n   461→    #[test]\n   462→    fn test_calendar_state_serialization() {\n   463→        let mut state = CalendarState::new();\n   464→        state.add_event(create_test_event(\"Test Event\", 15, 10));\n   465→        state.set_view_mode(ViewMode::Week);\n   466→\n   467→        let json = serde_json::to_string(&state).unwrap();\n   468→        let deserialized: CalendarState = serde_json::from_str(&json).unwrap();\n   469→\n   470→        assert_eq!(state.view_mode, deserialized.view_mode);\n   471→        assert_eq!(state.events.len(), deserialized.events.len());\n   472→        assert_eq!(state.events[0].title, deserialized.events[0].title);\n   473→    }\n   474→\n   475→    #[test]\n   476→    fn test_go_to_today() {\n   477→        let mut state = CalendarState::new();\n   478→        state.current_date = NaiveDate::from_ymd_opt(2020, 1, 1).unwrap();\n   479→\n   480→        state.go_to_today();\n   481→        let today = chrono::Local::now().date_naive();\n   482→        assert_eq!(state.current_date, today);\n   483→    }\n   484→}\n   485→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b01c02b5-c3bf-4330-afae-c2052155ab63","uuid":"b35426fd-2a44-4a67-bf2a-5fa88502176c","tool_use_result":{"type":"text","file":{"filePath":"/Users/sqibo/devel/clawd/src/calendar/types.rs","content":"use chrono::{NaiveDate, Datelike, Duration};\nuse serde::{Deserialize, Serialize};\nuse crate::events::Event;\n\n/// Represents different view modes for the calendar\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\npub enum ViewMode {\n    Day,\n    Week,\n    Month,\n    Year,\n}\n\nimpl Default for ViewMode {\n    fn default() -> Self {\n        ViewMode::Month\n    }\n}\n\n/// Represents a calendar view\n#[derive(Debug, Clone)]\npub struct Calendar {\n    pub current_date: NaiveDate,\n}\n\nimpl Calendar {\n    pub fn new() -> Self {\n        Self {\n            current_date: chrono::Local::now().date_naive(),\n        }\n    }\n\n    pub fn month(&self) -> u32 {\n        self.current_date.month()\n    }\n\n    pub fn year(&self) -> i32 {\n        self.current_date.year()\n    }\n}\n\nimpl Default for Calendar {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\n/// Main state management for the calendar application\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct CalendarState {\n    pub current_date: NaiveDate,\n    pub view_mode: ViewMode,\n    pub events: Vec<Event>,\n    pub selected_event_index: Option<usize>,\n}\n\nimpl CalendarState {\n    pub fn new() -> Self {\n        Self {\n            current_date: chrono::Local::now().date_naive(),\n            view_mode: ViewMode::default(),\n            events: Vec::new(),\n            selected_event_index: None,\n        }\n    }\n\n    /// Add an event to the calendar\n    pub fn add_event(&mut self, event: Event) {\n        self.events.push(event);\n        self.sort_events();\n    }\n\n    /// Remove an event by ID\n    pub fn remove_event(&mut self, event_id: &str) -> Option<Event> {\n        if let Some(pos) = self.events.iter().position(|e| e.id == event_id) {\n            Some(self.events.remove(pos))\n        } else {\n            None\n        }\n    }\n\n    /// Get an event by ID\n    pub fn get_event(&self, event_id: &str) -> Option<&Event> {\n        self.events.iter().find(|e| e.id == event_id)\n    }\n\n    /// Get a mutable reference to an event by ID\n    pub fn get_event_mut(&mut self, event_id: &str) -> Option<&mut Event> {\n        self.events.iter_mut().find(|e| e.id == event_id)\n    }\n\n    /// Get all events for a specific date\n    pub fn events_on_date(&self, date: NaiveDate) -> Vec<&Event> {\n        self.events\n            .iter()\n            .filter(|e| e.start_time.date() == date)\n            .collect()\n    }\n\n    /// Get all events in a date range\n    pub fn events_in_range(&self, start: NaiveDate, end: NaiveDate) -> Vec<&Event> {\n        self.events\n            .iter()\n            .filter(|e| {\n                let event_date = e.start_time.date();\n                event_date >= start && event_date <= end\n            })\n            .collect()\n    }\n\n    /// Change the view mode\n    pub fn set_view_mode(&mut self, mode: ViewMode) {\n        self.view_mode = mode;\n    }\n\n    /// Navigate to next period based on current view mode\n    pub fn next_period(&mut self) {\n        self.current_date = match self.view_mode {\n            ViewMode::Day => self.current_date + Duration::days(1),\n            ViewMode::Week => self.current_date + Duration::weeks(1),\n            ViewMode::Month => {\n                let month = self.current_date.month();\n                let year = self.current_date.year();\n                if month == 12 {\n                    NaiveDate::from_ymd_opt(year + 1, 1, 1).unwrap()\n                } else {\n                    NaiveDate::from_ymd_opt(year, month + 1, 1).unwrap()\n                }\n            }\n            ViewMode::Year => {\n                NaiveDate::from_ymd_opt(self.current_date.year() + 1, 1, 1).unwrap()\n            }\n        };\n    }\n\n    /// Navigate to previous period based on current view mode\n    pub fn previous_period(&mut self) {\n        self.current_date = match self.view_mode {\n            ViewMode::Day => self.current_date - Duration::days(1),\n            ViewMode::Week => self.current_date - Duration::weeks(1),\n            ViewMode::Month => {\n                let month = self.current_date.month();\n                let year = self.current_date.year();\n                if month == 1 {\n                    NaiveDate::from_ymd_opt(year - 1, 12, 1).unwrap()\n                } else {\n                    NaiveDate::from_ymd_opt(year, month - 1, 1).unwrap()\n                }\n            }\n            ViewMode::Year => {\n                NaiveDate::from_ymd_opt(self.current_date.year() - 1, 1, 1).unwrap()\n            }\n        };\n    }\n\n    /// Go to today's date\n    pub fn go_to_today(&mut self) {\n        self.current_date = chrono::Local::now().date_naive();\n    }\n\n    /// Select next event\n    pub fn select_next_event(&mut self) {\n        if self.events.is_empty() {\n            self.selected_event_index = None;\n            return;\n        }\n\n        self.selected_event_index = Some(match self.selected_event_index {\n            Some(index) => {\n                if index >= self.events.len() - 1 {\n                    0\n                } else {\n                    index + 1\n                }\n            }\n            None => 0,\n        });\n    }\n\n    /// Select previous event\n    pub fn select_previous_event(&mut self) {\n        if self.events.is_empty() {\n            self.selected_event_index = None;\n            return;\n        }\n\n        self.selected_event_index = Some(match self.selected_event_index {\n            Some(index) => {\n                if index == 0 {\n                    self.events.len() - 1\n                } else {\n                    index - 1\n                }\n            }\n            None => self.events.len() - 1,\n        });\n    }\n\n    /// Get currently selected event\n    pub fn selected_event(&self) -> Option<&Event> {\n        self.selected_event_index\n            .and_then(|index| self.events.get(index))\n    }\n\n    /// Sort events by start time\n    fn sort_events(&mut self) {\n        self.events.sort_by(|a, b| a.start_time.cmp(&b.start_time));\n    }\n\n    /// Get total number of events\n    pub fn event_count(&self) -> usize {\n        self.events.len()\n    }\n}\n\nimpl Default for CalendarState {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::events::{Event, Category, Reminder, RecurringRules, RecurrenceFrequency};\n\n    fn create_test_event(title: &str, day: u32, hour: u32) -> Event {\n        let start = NaiveDate::from_ymd_opt(2024, 1, day)\n            .unwrap()\n            .and_hms_opt(hour, 0, 0)\n            .unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, day)\n            .unwrap()\n            .and_hms_opt(hour + 1, 0, 0)\n            .unwrap();\n        Event::new(title.to_string(), start, end)\n    }\n\n    #[test]\n    fn test_calendar_state_creation() {\n        let state = CalendarState::new();\n\n        assert_eq!(state.view_mode, ViewMode::Month);\n        assert_eq!(state.events.len(), 0);\n        assert_eq!(state.selected_event_index, None);\n    }\n\n    #[test]\n    fn test_add_event() {\n        let mut state = CalendarState::new();\n        let event = create_test_event(\"Test Event\", 15, 10);\n\n        state.add_event(event.clone());\n\n        assert_eq!(state.events.len(), 1);\n        assert_eq!(state.events[0].title, \"Test Event\");\n    }\n\n    #[test]\n    fn test_remove_event() {\n        let mut state = CalendarState::new();\n        let event = create_test_event(\"Test Event\", 15, 10);\n        let event_id = event.id.clone();\n\n        state.add_event(event);\n        assert_eq!(state.events.len(), 1);\n\n        let removed = state.remove_event(&event_id);\n        assert!(removed.is_some());\n        assert_eq!(state.events.len(), 0);\n    }\n\n    #[test]\n    fn test_get_event() {\n        let mut state = CalendarState::new();\n        let event = create_test_event(\"Test Event\", 15, 10);\n        let event_id = event.id.clone();\n\n        state.add_event(event);\n\n        let found = state.get_event(&event_id);\n        assert!(found.is_some());\n        assert_eq!(found.unwrap().title, \"Test Event\");\n    }\n\n    #[test]\n    fn test_events_on_date() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        state.add_event(create_test_event(\"Event 2\", 15, 14));\n        state.add_event(create_test_event(\"Event 3\", 16, 10));\n\n        let date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n        let events = state.events_on_date(date);\n\n        assert_eq!(events.len(), 2);\n    }\n\n    #[test]\n    fn test_events_in_range() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 1\", 10, 10));\n        state.add_event(create_test_event(\"Event 2\", 15, 10));\n        state.add_event(create_test_event(\"Event 3\", 20, 10));\n        state.add_event(create_test_event(\"Event 4\", 25, 10));\n\n        let start = NaiveDate::from_ymd_opt(2024, 1, 12).unwrap();\n        let end = NaiveDate::from_ymd_opt(2024, 1, 22).unwrap();\n        let events = state.events_in_range(start, end);\n\n        assert_eq!(events.len(), 2);\n    }\n\n    #[test]\n    fn test_view_mode_changes() {\n        let mut state = CalendarState::new();\n\n        assert_eq!(state.view_mode, ViewMode::Month);\n\n        state.set_view_mode(ViewMode::Week);\n        assert_eq!(state.view_mode, ViewMode::Week);\n\n        state.set_view_mode(ViewMode::Day);\n        assert_eq!(state.view_mode, ViewMode::Day);\n    }\n\n    #[test]\n    fn test_next_period_day() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n        state.set_view_mode(ViewMode::Day);\n\n        state.next_period();\n        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 1, 16).unwrap());\n    }\n\n    #[test]\n    fn test_next_period_month() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n        state.set_view_mode(ViewMode::Month);\n\n        state.next_period();\n        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 2, 1).unwrap());\n    }\n\n    #[test]\n    fn test_next_period_year() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2024, 6, 15).unwrap();\n        state.set_view_mode(ViewMode::Year);\n\n        state.next_period();\n        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2025, 1, 1).unwrap());\n    }\n\n    #[test]\n    fn test_previous_period_day() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n        state.set_view_mode(ViewMode::Day);\n\n        state.previous_period();\n        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2024, 1, 14).unwrap());\n    }\n\n    #[test]\n    fn test_previous_period_month() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n        state.set_view_mode(ViewMode::Month);\n\n        state.previous_period();\n        assert_eq!(state.current_date, NaiveDate::from_ymd_opt(2023, 12, 1).unwrap());\n    }\n\n    #[test]\n    fn test_event_selection() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        state.add_event(create_test_event(\"Event 2\", 16, 10));\n        state.add_event(create_test_event(\"Event 3\", 17, 10));\n\n        assert_eq!(state.selected_event_index, None);\n\n        state.select_next_event();\n        assert_eq!(state.selected_event_index, Some(0));\n\n        state.select_next_event();\n        assert_eq!(state.selected_event_index, Some(1));\n\n        state.select_previous_event();\n        assert_eq!(state.selected_event_index, Some(0));\n    }\n\n    #[test]\n    fn test_event_selection_wrapping() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        state.add_event(create_test_event(\"Event 2\", 16, 10));\n\n        state.select_next_event();\n        state.select_next_event();\n        assert_eq!(state.selected_event_index, Some(1));\n\n        // Should wrap to beginning\n        state.select_next_event();\n        assert_eq!(state.selected_event_index, Some(0));\n\n        // Should wrap to end\n        state.select_previous_event();\n        assert_eq!(state.selected_event_index, Some(1));\n    }\n\n    #[test]\n    fn test_selected_event() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        state.add_event(create_test_event(\"Event 2\", 16, 10));\n\n        assert!(state.selected_event().is_none());\n\n        state.select_next_event();\n        let selected = state.selected_event();\n        assert!(selected.is_some());\n        assert_eq!(selected.unwrap().title, \"Event 1\");\n    }\n\n    #[test]\n    fn test_event_sorting() {\n        let mut state = CalendarState::new();\n\n        state.add_event(create_test_event(\"Event 3\", 17, 10));\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        state.add_event(create_test_event(\"Event 2\", 16, 10));\n\n        // Events should be sorted by start time\n        assert_eq!(state.events[0].title, \"Event 1\");\n        assert_eq!(state.events[1].title, \"Event 2\");\n        assert_eq!(state.events[2].title, \"Event 3\");\n    }\n\n    #[test]\n    fn test_event_count() {\n        let mut state = CalendarState::new();\n\n        assert_eq!(state.event_count(), 0);\n\n        state.add_event(create_test_event(\"Event 1\", 15, 10));\n        assert_eq!(state.event_count(), 1);\n\n        state.add_event(create_test_event(\"Event 2\", 16, 10));\n        assert_eq!(state.event_count(), 2);\n    }\n\n    #[test]\n    fn test_calendar_state_serialization() {\n        let mut state = CalendarState::new();\n        state.add_event(create_test_event(\"Test Event\", 15, 10));\n        state.set_view_mode(ViewMode::Week);\n\n        let json = serde_json::to_string(&state).unwrap();\n        let deserialized: CalendarState = serde_json::from_str(&json).unwrap();\n\n        assert_eq!(state.view_mode, deserialized.view_mode);\n        assert_eq!(state.events.len(), deserialized.events.len());\n        assert_eq!(state.events[0].title, deserialized.events[0].title);\n    }\n\n    #[test]\n    fn test_go_to_today() {\n        let mut state = CalendarState::new();\n        state.current_date = NaiveDate::from_ymd_opt(2020, 1, 1).unwrap();\n\n        state.go_to_today();\n        let today = chrono::Local::now().date_naive();\n        assert_eq!(state.current_date, today);\n    }\n}\n","numLines":485,"startLine":1,"totalLines":485}}}
