n   275→        let mut state = CalendarState::new();\n   276→        let event = create_test_event(\"Test Event\", 15, 10);\n   277→        let event_id = event.id.clone();\n   278→\n   279→        state.add_event(event);\n   280→\n   281→        let found = state.get_event(&event_id);\n   282→        assert!(found.is_some());\n   283→        assert_eq!(found.unwrap().title, \"Test Event\");\n   284→    }\n   285→\n   286→    #[test]\n   287→    fn test_events_on_date() {\n   288→        let mut state = CalendarState::new();\n   289→\n   290→        state.add_event(create_test_event(\"Event 1\", 15, 10));\n   291→        state.add_event(create_test_event(\"Event 2\", 15, 14));\n   292→        state.add_event(create_test_event(\"Event 3\", 16, 10));\n   293→\n   294→        let date = NaiveDate::from_ymd_opt(2024, 1, 15).unwrap();\n   295→        let events = state.events_on_date(date);\n   296→\n   297→        assert_eq!(events.len(), 2);\n   298→    }\n   299→\n   300→    #[test]\n   301→    fn test_events_in_range() {\n   302→        let mut state = CalendarState::new();\n   303→\n   304→        state.add_event(create_test_event(\"Event 1\", 10, 10));\n   305→        state.add_event(create_test_event(\"Event 2\", 15, 10));\n   306→        state.add_event(create_test_event(\"Event 3\", 20, 10));\n   307→        state.add_event(create_test_event(\"Event 4\", 25, 10));\n   308→\n   309→        let start = NaiveDate::from_ymd_opt(2024, 1, 12).unwrap();\n   310→        let end = NaiveDate::from_ymd_opt(2024, 1, 22).unwrap();\n   311→        let events = state.events_in_range(start, end);\n   312→\n   313→        assert_eq!(events.len(), 2);\n   314→    }\n   315→\n   316→    #[test]\n   317→    fn test_view_mode_changes() {\n   318→        let mut state = CalendarState::new();\n   319→\n   320→        assert_eq!(state.view_mode, ViewMode::Month);\n   321→\n   322→        state.set_view_mode(ViewMode::Week);\n   323→        assert_eq!(state.view_mode, ViewMode::Week);\