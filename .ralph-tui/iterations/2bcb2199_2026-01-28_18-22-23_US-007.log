{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HYrkBTZqLSRspAcXdc3G9t","type":"tool_result","content":"     1→use chrono::{Datelike, NaiveDate};\n     2→use ratatui::{\n     3→    layout::{Constraint, Direction, Layout, Rect},\n     4→    style::{Color, Modifier, Style},\n     5→    text::{Line, Span},\n     6→    widgets::{Block, Borders, List, ListItem, Paragraph},\n     7→    Frame,\n     8→};\n     9→use crate::calendar::CalendarState;\n    10→\n    11→pub struct MonthView {\n    12→    pub selected_date: NaiveDate,\n    13→}\n    14→\n    15→impl MonthView {\n    16→    pub fn new() -> Self {\n    17→        Self {\n    18→            selected_date: chrono::Local::now().date_naive(),\n    19→        }\n    20→    }\n    21→\n    22→    pub fn render(&mut self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n    23→        // Split the screen into calendar (left) and side panel (right)\n    24→        let chunks = Layout::default()\n    25→            .direction(Direction::Horizontal)\n    26→            .constraints([Constraint::Percentage(70), Constraint::Percentage(30)])\n    27→            .split(area);\n    28→\n    29→        self.render_calendar(frame, chunks[0], state);\n    30→        self.render_side_panel(frame, chunks[1], state);\n    31→    }\n    32→\n    33→    fn render_calendar(&self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n    34→        let block = Block::default()\n    35→            .title(format!(\n    36→                \" {} {} \",\n    37→                self.month_name(state.current_date.month()),\n    38→                state.current_date.year()\n    39→            ))\n    40→            .borders(Borders::ALL);\n    41→\n    42→        let inner_area = block.inner(area);\n    43→        frame.render_widget(block, area);\n    44→\n    45→        // Calculate calendar grid\n    46→        let days = self.get_month_days(state.current_date);\n    47→\n    48→        // Split into header row and 6 week rows\n    49→        let vertical_chunks = Layout::default()\n    50→            .direction(Direction::Vertical)\n    51→            .constraints([\n    52→                Constraint::Length(1),  // Header\n    53→                Constraint::Length(3),  // Week 1\n    54→                Constraint::Length(3),  // Week 2\n    55→                Constraint::Length(3),  // Week 3\n    56→                Constraint::Length(3),  // Week 4\n    57→                Constraint::Length(3),  // Week 5\n    58→                Constraint::Length(3),  // Week 6\n    59→            ])\n    60→            .split(inner_area);\n    61→\n    62→        // Render header (day names)\n    63→        self.render_week_header(frame, vertical_chunks[0]);\n    64→\n    65→        // Render weeks\n    66→        for (week_idx, week_chunk) in vertical_chunks[1..].iter().enumerate() {\n    67→            let week_start = week_idx * 7;\n    68→            let week_end = (week_start + 7).min(days.len());\n    69→            if week_start < days.len() {\n    70→                let week_days = &days[week_start..week_end];\n    71→                self.render_week(frame, *week_chunk, week_days, state);\n    72→            }\n    73→        }\n    74→    }\n    75→\n    76→    fn render_week_header(&self, frame: &mut Frame, area: Rect) {\n    77→        let day_names = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];\n    78→        let chunks = Layout::default()\n    79→            .direction(Direction::Horizontal)\n    80→            .constraints(vec![Constraint::Percentage(14); 7])\n    81→            .split(area);\n    82→\n    83→        for (i, name) in day_names.iter().enumerate() {\n    84→            let paragraph = Paragraph::new(*name)\n    85→                .style(Style::default().fg(Color::Cyan).add_modifier(Modifier::BOLD));\n    86→            frame.render_widget(paragraph, chunks[i]);\n    87→        }\n    88→    }\n    89→\n    90→    fn render_week(&self, frame: &mut Frame, area: Rect, days: &[Option<NaiveDate>], state: &CalendarState) {\n    91→        let chunks = Layout::default()\n    92→            .direction(Direction::Horizontal)\n    93→            .constraints(vec![Constraint::Percentage(14); 7])\n    94→            .split(area);\n    95→\n    96→        let today = chrono::Local::now().date_naive();\n    97→\n    98→        for (i, day_option) in days.iter().enumerate() {\n    99→            if let Some(day) = day_option {\n   100→                let is_today = *day == today;\n   101→                let is_selected = *day == self.selected_date;\n   102→                let has_events = !state.events_on_date(*day).is_empty();\n   103→\n   104→                let mut style = Style::default();\n   105→                if is_today {\n   106→                    style = style.fg(Color::Yellow).add_modifier(Modifier::BOLD);\n   107→                }\n   108→                if is_selected {\n   109→                    style = style.bg(Color::DarkGray);\n   110→                }\n   111→\n   112→                let day_str = format!(\"{:2}\", day.day());\n   113→                let indicator = if has_events { \"*\" } else { \" \" };\n   114→\n   115→                let lines = vec![\n   116→                    Line::from(Span::styled(day_str, style)),\n   117→                    Line::from(Span::styled(indicator, Style::default().fg(Color::Green))),\n   118→                ];\n   119→\n   120→                let paragraph = Paragraph::new(lines);\n   121→                frame.render_widget(paragraph, chunks[i]);\n   122→            }\n   123→        }\n   124→    }\n   125→\n   126→    fn render_side_panel(&self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n   127→        let events = state.events_on_date(self.selected_date);\n   128→\n   129→        let title = format!(\n   130→            \" {} \",\n   131→            self.selected_date.format(\"%b %d, %Y\")\n   132→        );\n   133→\n   134→        let block = Block::default()\n   135→            .title(title)\n   136→            .borders(Borders::ALL);\n   137→\n   138→        let inner_area = block.inner(area);\n   139→        frame.render_widget(block, area);\n   140→\n   141→        if events.is_empty() {\n   142→            let paragraph = Paragraph::new(\"No events\");\n   143→            frame.render_widget(paragraph, inner_area);\n   144→        } else {\n   145→            let items: Vec<ListItem> = events\n   146→                .iter()\n   147→                .map(|event| {\n   148→                    let time = event.start_time.format(\"%H:%M\").to_string();\n   149→                    let content = format!(\"{} - {}\", time, event.title);\n   150→                    ListItem::new(content)\n   151→                })\n   152→                .collect();\n   153→\n   154→            let list = List::new(items);\n   155→            frame.render_widget(list, inner_area);\n   156→        }\n   157→    }\n   158→\n   159→    fn get_month_days(&self, date: NaiveDate) -> Vec<Option<NaiveDate>> {\n   160→        let year = date.year();\n   161→        let month = date.month();\n   162→\n   163→        // First day of the month\n   164→        let first_day = NaiveDate::from_ymd_opt(year, month, 1).unwrap();\n   165→\n   166→        // Find the weekday of the first day (0 = Sunday, 6 = Saturday)\n   167→        let first_weekday = first_day.weekday().num_days_from_sunday() as usize;\n   168→\n   169→        // Days in month\n   170→        let days_in_month = self.days_in_month(year, month);\n   171→\n   172→        // Create 42-day grid (6 weeks * 7 days)\n   173→        let mut days = vec![None; 42];\n   174→\n   175→        // Fill in the days\n   176→        for day in 1..=days_in_month {\n   177→            let index = first_weekday + day - 1;\n   178→            days[index] = NaiveDate::from_ymd_opt(year, month, day as u32);\n   179→        }\n   180→\n   181→        days\n   182→    }\n   183→\n   184→    fn days_in_month(&self, year: i32, month: u32) -> usize {\n   185→        let next_month = if month == 12 { 1 } else { month + 1 };\n   186→        let next_year = if month == 12 { year + 1 } else { year };\n   187→\n   188→        let first_of_next = NaiveDate::from_ymd_opt(next_year, next_month, 1).unwrap();\n   189→        let last_of_current = first_of_next.pred_opt().unwrap();\n   190→\n   191→        last_of_current.day() as usize\n   192→    }\n   193→\n   194→    fn month_name(&self, month: u32) -> &'static str {\n   195→        match month {\n   196→            1 => \"January\",\n   197→            2 => \"February\",\n   198→            3 => \"March\",\n   199→            4 => \"April\",\n   200→            5 => \"May\",\n   201→            6 => \"June\",\n   202→            7 => \"July\",\n   203→            8 => \"August\",\n   204→            9 => \"September\",\n   205→            10 => \"October\",\n   206→            11 => \"November\",\n   207→            12 => \"December\",\n   208→            _ => \"Unknown\",\n   209→        }\n   210→    }\n   211→\n   212→    pub fn select_date(&mut self, date: NaiveDate) {\n   213→        self.selected_date = date;\n   214→    }\n   215→\n   216→    pub fn move_selection(&mut self, days: i64) {\n   217→        self.selected_date = self.selected_date\n   218→            .checked_add_signed(chrono::Duration::days(days))\n   219→            .unwrap_or(self.selected_date);\n   220→    }\n   221→\n   222→    pub fn move_to_week_start(&mut self) {\n   223→        let weekday = self.selected_date.weekday().num_days_from_sunday();\n   224→        self.selected_date = self.selected_date\n   225→            .checked_sub_signed(chrono::Duration::days(weekday as i64))\n   226→            .unwrap_or(self.selected_date);\n   227→    }\n   228→\n   229→    pub fn move_to_week_end(&mut self) {\n   230→        let weekday = self.selected_date.weekday().num_days_from_sunday();\n   231→        let days_to_saturday = 6 - weekday;\n   232→        self.selected_date = self.selected_date\n   233→            .checked_add_signed(chrono::Duration::days(days_to_saturday as i64))\n   234→            .unwrap_or(self.selected_date);\n   235→    }\n   236→\n   237→    pub fn move_to_prev_month(&mut self) {\n   238→        let current_day = self.selected_date.day();\n   239→        let month = self.selected_date.month();\n   240→        let year = self.selected_date.year();\n   241→\n   242→        let (prev_month, prev_year) = if month == 1 {\n   243→            (12, year - 1)\n   244→        } else {\n   245→            (month - 1, year)\n   246→        };\n   247→\n   248→        // Get the number of days in the previous month\n   249→        let days_in_prev_month = self.days_in_month(prev_year, prev_month);\n   250→        let target_day = current_day.min(days_in_prev_month as u32);\n   251→\n   252→        self.selected_date = NaiveDate::from_ymd_opt(prev_year, prev_month, target_day)\n   253→            .unwrap_or(self.selected_date);\n   254→    }\n   255→\n   256→    pub fn move_to_next_month(&mut self) {\n   257→        let current_day = self.selected_date.day();\n   258→        let month = self.selected_date.month();\n   259→        let year = self.selected_date.year();\n   260→\n   261→        let (next_month, next_year) = if month == 12 {\n   262→            (1, year + 1)\n   263→        } else {\n   264→            (month + 1, year)\n   265→        };\n   266→\n   267→        // Get the number of days in the next month\n   268→        let days_in_next_month = self.days_in_month(next_year, next_month);\n   269→        let target_day = current_day.min(days_in_next_month as u32);\n   270→\n   271→        self.selected_date = NaiveDate::from_ymd_opt(next_year, next_month, target_day)\n   272→            .unwrap_or(self.selected_date);\n   273→    }\n   274→\n   275→    pub fn jump_to_today(&mut self) {\n   276→        self.selected_date = chrono::Local::now().date_naive();\n   277→    }\n   278→}\n   279→\n   280→impl Default for MonthView {\n   281→    fn default() -> Self {\n   282→        Self::new()\n   283→    }\n   284→}\n   285→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d661c886-60ad-41a9-a4d9-201f10ffad3d","uuid":"4c8b9302-7e1e-4b85-b177-fc378ebcf514","tool_use_result":{"type":"text","file":{"filePath":"/Users/sqibo/devel/clawd/src/views/month.rs","content":"use chrono::{Datelike, NaiveDate};\nuse ratatui::{\n    layout::{Constraint, Direction, Layout, Rect},\n    style::{Color, Modifier, Style},\n    text::{Line, Span},\n    widgets::{Block, Borders, List, ListItem, Paragraph},\n    Frame,\n};\nuse crate::calendar::CalendarState;\n\npub struct MonthView {\n    pub selected_date: NaiveDate,\n}\n\nimpl MonthView {\n    pub fn new() -> Self {\n        Self {\n            selected_date: chrono::Local::now().date_naive(),\n        }\n    }\n\n    pub fn render(&mut self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n        // Split the screen into calendar (left) and side panel (right)\n        let chunks = Layout::default()\n            .direction(Direction::Horizontal)\n            .constraints([Constraint::Percentage(70), Constraint::Percentage(30)])\n            .split(area);\n\n        self.render_calendar(frame, chunks[0], state);\n        self.render_side_panel(frame, chunks[1], state);\n    }\n\n    fn render_calendar(&self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n        let block = Block::default()\n            .title(format!(\n                \" {} {} \",\n                self.month_name(state.current_date.month()),\n                state.current_date.year()\n            ))\n            .borders(Borders::ALL);\n\n        let inner_area = block.inner(area);\n        frame.render_widget(block, area);\n\n        // Calculate calendar grid\n        let days = self.get_month_days(state.current_date);\n\n        // Split into header row and 6 week rows\n        let vertical_chunks = Layout::default()\n            .direction(Direction::Vertical)\n            .constraints([\n                Constraint::Length(1),  // Header\n                Constraint::Length(3),  // Week 1\n                Constraint::Length(3),  // Week 2\n                Constraint::Length(3),  // Week 3\n                Constraint::Length(3),  // Week 4\n                Constraint::Length(3),  // Week 5\n                Constraint::Length(3),  // Week 6\n            ])\n            .split(inner_area);\n\n        // Render header (day names)\n        self.render_week_header(frame, vertical_chunks[0]);\n\n        // Render weeks\n        for (week_idx, week_chunk) in vertical_chunks[1..].iter().enumerate() {\n            let week_start = week_idx * 7;\n            let week_end = (week_start + 7).min(days.len());\n            if week_start < days.len() {\n                let week_days = &days[week_start..week_end];\n                self.render_week(frame, *week_chunk, week_days, state);\n            }\n        }\n    }\n\n    fn render_week_header(&self, frame: &mut Frame, area: Rect) {\n        let day_names = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];\n        let chunks = Layout::default()\n            .direction(Direction::Horizontal)\n            .constraints(vec![Constraint::Percentage(14); 7])\n            .split(area);\n\n        for (i, name) in day_names.iter().enumerate() {\n            let paragraph = Paragraph::new(*name)\n                .style(Style::default().fg(Color::Cyan).add_modifier(Modifier::BOLD));\n            frame.render_widget(paragraph, chunks[i]);\n        }\n    }\n\n    fn render_week(&self, frame: &mut Frame, area: Rect, days: &[Option<NaiveDate>], state: &CalendarState) {\n        let chunks = Layout::default()\n            .direction(Direction::Horizontal)\n            .constraints(vec![Constraint::Percentage(14); 7])\n            .split(area);\n\n        let today = chrono::Local::now().date_naive();\n\n        for (i, day_option) in days.iter().enumerate() {\n            if let Some(day) = day_option {\n                let is_today = *day == today;\n                let is_selected = *day == self.selected_date;\n                let has_events = !state.events_on_date(*day).is_empty();\n\n                let mut style = Style::default();\n                if is_today {\n                    style = style.fg(Color::Yellow).add_modifier(Modifier::BOLD);\n                }\n                if is_selected {\n                    style = style.bg(Color::DarkGray);\n                }\n\n                let day_str = format!(\"{:2}\", day.day());\n                let indicator = if has_events { \"*\" } else { \" \" };\n\n                let lines = vec![\n                    Line::from(Span::styled(day_str, style)),\n                    Line::from(Span::styled(indicator, Style::default().fg(Color::Green))),\n                ];\n\n                let paragraph = Paragraph::new(lines);\n                frame.render_widget(paragraph, chunks[i]);\n            }\n        }\n    }\n\n    fn render_side_panel(&self, frame: &mut Frame, area: Rect, state: &CalendarState) {\n        let events = state.events_on_date(self.selected_date);\n\n        let title = format!(\n            \" {} \",\n            self.selected_date.format(\"%b %d, %Y\")\n        );\n\n        let block = Block::default()\n            .title(title)\n            .borders(Borders::ALL);\n\n        let inner_area = block.inner(area);\n        frame.render_widget(block, area);\n\n        if events.is_empty() {\n            let paragraph = Paragraph::new(\"No events\");\n            frame.render_widget(paragraph, inner_area);\n        } else {\n            let items: Vec<ListItem> = events\n                .iter()\n                .map(|event| {\n                    let time = event.start_time.format(\"%H:%M\").to_string();\n                    let content = format!(\"{} - {}\", time, event.title);\n                    ListItem::new(content)\n                })\n                .collect();\n\n            let list = List::new(items);\n            frame.render_widget(list, inner_area);\n        }\n    }\n\n    fn get_month_days(&self, date: NaiveDate) -> Vec<Option<NaiveDate>> {\n        let year = date.year();\n        let month = date.month();\n\n        // First day of the month\n        let first_day = NaiveDate::from_ymd_opt(year, month, 1).unwrap();\n\n        // Find the weekday of the first day (0 = Sunday, 6 = Saturday)\n        let first_weekday = first_day.weekday().num_days_from_sunday() as usize;\n\n        // Days in month\n        let days_in_month = self.days_in_month(year, month);\n\n        // Create 42-day grid (6 weeks * 7 days)\n        let mut days = vec![None; 42];\n\n        // Fill in the days\n        for day in 1..=days_in_month {\n            let index = first_weekday + day - 1;\n            days[index] = NaiveDate::from_ymd_opt(year, month, day as u32);\n        }\n\n        days\n    }\n\n    fn days_in_month(&self, year: i32, month: u32) -> usize {\n        let next_month = if month == 12 { 1 } else { month + 1 };\n        let next_year = if month == 12 { year + 1 } else { year };\n\n        let first_of_next = NaiveDate::from_ymd_opt(next_year, next_month, 1).unwrap();\n        let last_of_current = first_of_next.pred_opt().unwrap();\n\n        last_of_current.day() as usize\n    }\n\n    fn month_name(&self, month: u32) -> &'static str {\n        match month {\n            1 => \"January\",\n            2 => \"February\",\n            3 => \"March\",\n            4 => \"April\",\n            5 => \"May\",\n            6 => \"June\",\n            7 => \"July\",\n            8 => \"August\",\n            9 => \"September\",\n            10 => \"October\",\n            11 => \"November\",\n            12 => \"December\",\n            _ => \"Unknown\",\n        }\n    }\n\n    pub fn select_date(&mut self, date: NaiveDate) {\n        self.selected_date = date;\n    }\n\n    pub fn move_selection(&mut self, days: i64) {\n        self.selected_date = self.selected_date\n            .checked_add_signed(chrono::Duration::days(days))\n            .unwrap_or(self.selected_date);\n    }\n\n    pub fn move_to_week_start(&mut self) {\n        let weekday = self.selected_date.weekday().num_days_from_sunday();\n        self.selected_date = self.selected_date\n            .checked_sub_signed(chrono::Duration::days(weekday as i64))\n            .unwrap_or(self.selected_date);\n    }\n\n    pub fn move_to_week_end(&mut self) {\n        let weekday = self.selected_date.weekday().num_days_from_sunday();\n        let days_to_saturday = 6 - weekday;\n        self.selected_date = self.selected_date\n            .checked_add_signed(chrono::Duration::days(days_to_saturday as i64))\n            .unwrap_or(self.selected_date);\n    }\n\n    pub fn move_to_prev_month(&mut self) {\n        let current_day = self.selected_date.day();\n        let month = self.selected_date.month();\n        let year = self.selected_date.year();\n\n        let (prev_month, prev_year) = if month == 1 {\n            (12, year - 1)\n        } else {\n            (month - 1, year)\n        };\n\n        // Get the number of days in the previous month\n        let days_in_prev_month = self.days_in_month(prev_year, prev_month);\n        let target_day = current_day.min(days_in_prev_month as u32);\n\n        self.selected_date = NaiveDate::from_ymd_opt(prev_year, prev_month, target_day)\n            .unwrap_or(self.selected_date);\n    }\n\n    pub fn move_to_next_month(&mut self) {\n        let current_day = self.selected_date.day();\n        let month = self.selected_date.month();\n        let year = self.selected_date.year();\n\n        let (next_month, next_year) = if month == 12 {\n            (1, year + 1)\n        } else {\n            (month + 1, year)\n        };\n\n        // Get the number of days in the next month\n        let days_in_next_month = self.days_in_month(next_year, next_month);\n        let target_day = current_day.min(days_in_next_month as u32);\n\n        self.selected_date = NaiveDate::from_ymd_opt(next_year, next_month, target_day)\n            .unwrap_or(self.selected_date);\n    }\n\n    pub fn jump_to_today(&mut self) {\n        self.selected_date = chrono::Local::now().date_naive();\n    }\n}\n\nimpl Default for MonthView {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n","numLines":285,"startLine":1,"totalLines":285}}}
