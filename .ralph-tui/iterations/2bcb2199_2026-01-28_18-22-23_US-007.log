{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017wZ9we6Y4cMhBUJNfiDHAZ","type":"tool_result","content":"     1→use chrono::{NaiveDate, Datelike, Duration};\n     2→use serde::{Deserialize, Serialize};\n     3→use crate::events::Event;\n     4→\n     5→/// Represents different view modes for the calendar\n     6→#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n     7→pub enum ViewMode {\n     8→    Day,\n     9→    Week,\n    10→    Month,\n    11→    Year,\n    12→}\n    13→\n    14→impl Default for ViewMode {\n    15→    fn default() -> Self {\n    16→        ViewMode::Month\n    17→    }\n    18→}\n    19→\n    20→/// Represents a calendar view\n    21→#[derive(Debug, Clone)]\n    22→pub struct Calendar {\n    23→    pub current_date: NaiveDate,\n    24→}\n    25→\n    26→impl Calendar {\n    27→    pub fn new() -> Self {\n    28→        Self {\n    29→            current_date: chrono::Local::now().date_naive(),\n    30→        }\n    31→    }\n    32→\n    33→    pub fn month(&self) -> u32 {\n    34→        self.current_date.month()\n    35→    }\n    36→\n    37→    pub fn year(&self) -> i32 {\n    38→        self.current_date.year()\n    39→    }\n    40→}\n    41→\n    42→impl Default for Calendar {\n    43→    fn default() -> Self {\n    44→        Self::new()\n    45→    }\n    46→}\n    47→\n    48→/// Main state management for the calendar application\n    49→#[derive(Debug, Clone, Serialize, Deserialize)]\n    50→pub struct CalendarState {\n    51→    pub current_date: NaiveDate,\n    52→    pub view_mode: ViewMode,\n    53→    pub events: Vec<Event>,\n    54→    pub selected_event_index: Option<usize>,\n    55→}\n    56→\n    57→impl CalendarState {\n    58→    pub fn new() -> Self {\n    59→        Self {\n    60→            current_date: chrono::Local::now().date_naive(),\n    61→            view_mode: ViewMode::default(),\n    62→            events: Vec::new(),\n    63→            selected_event_index: None,\n    64→        }\n    65→    }\n    66→\n    67→    /// Add an event to the calendar\n    68→    pub fn add_event(&mut self, event: Event) {\n    69→        self.events.push(event);\n    70→        self.sort_events();\n    71→    }\n    72→\n    73→    /// Remove an event by ID\n    74→    pub fn remove_event(&mut self, event_id: &str) -> Option<Event> {\n    75→        if let Some(pos) = self.events.iter().position(|e| e.id == event_id) {\n    76→            Some(self.events.remove(pos))\n    77→        } else {\n    78→            None\n    79→        }\n    80→    }\n    81→\n    82→    /// Get an event by ID\n    83→    pub fn get_event(&self, event_id: &str) -> Option<&Event> {\n    84→        self.events.iter().find(|e| e.id == event_id)\n    85→    }\n    86→\n    87→    /// Get a mutable reference to an event by ID\n    88→    pub fn get_event_mut(&mut self, event_id: &str) -> Option<&mut Event> {\n    89→        self.events.iter_mut().find(|e| e.id == event_id)\n    90→    }\n    91→\n    92→    /// Get all events for a specific date\n    93→    pub fn events_on_date(&self, date: NaiveDate) -> Vec<&Event> {\n    94→        self.events\n    95→            .iter()\n    96→            .filter(|e| e.start_time.date() == date)\n    97→            .collect()\n    98→    }\n    99→\n   100→    /// Get all events in a date range\n   101→    pub fn events_in_range(&self, start: NaiveDate, end: NaiveDate) -> Vec<&Event> {\n   102→        self.events\n   103→            .iter()\n   104→            .filter(|e| {\n   105→                let event_date = e.start_time.date();\n   106→                event_date >= start && event_date <= end\n   107→            })\n   108→            .collect()\n   109→    }\n   110→\n   111→    /// Change the view mode\n   112→    pub fn set_view_mode(&mut self, mode: ViewMode) {\n   113→        self.view_mode = mode;\n   114→    }\n   115→\n   116→    /// Navigate to next period based on current view mode\n   117→    pub fn next_period(&mut self) {\n   118→        self.current_date = match self.view_mode {\n   119→            ViewMode::Day => self.current_date + Duration::days(1),\n   120→            ViewMode::Week => self.current_date + Duration::weeks(1),\n   121→            ViewMode::Month => {\n   122→                let month = self.current_date.month();\n   123→                let year = self.current_date.year();\n   124→                if month == 12 {\n   125→                    NaiveDate::from_ymd_opt(year + 1, 1, 1).unwrap()\n   126→                } else {\n   127→                    NaiveDate::from_ymd_opt(year, month + 1, 1).unwrap()\n   128→                }\n   129→            }\n   130→            ViewMode::Year => {\n   131→                NaiveDate::from_ymd_opt(self.current_date.year() + 1, 1, 1).unwrap()\n   132→            }\n   133→        };\n   134→    }\n   135→\n   136→    /// Navigate to previous period based on current view mode\n   137→    pub fn previous_period(&mut self) {\n   138→        self.current_date = match self.view_mode {\n   139→            ViewMode::Day => self.current_date - Duration::days(1),\n   140→            ViewMode::Week => self.current_date - Duration::weeks(1),\n   141→            ViewMode::Month => {\n   142→                let month = self.current_date.month();\n   143→                let year = self.current_date.year();\n   144→                if month == 1 {\n   145→                    NaiveDate::from_ymd_opt(year - 1, 12, 1).unwrap()\n   146→                } else {\n   147→                    NaiveDate::from_ymd_opt(year, month - 1, 1).unwrap()\n   148→                }\n   149→            }\n   150→            ViewMode::Year => {\n   151→                NaiveDate::from_ymd_opt(self.current_date.year() - 1, 1, 1).unwrap()\n   152→            }\n   153→        };\n   154→    }\n   155→\n   156→    /// Go to today's date\n   157→    pub fn go_to_today(&mut self) {\n   158→        self.current_date = chrono::Local::now().date_naive();\n   